		safePositionAnchor[] = {20480,20480};
		safePositionRadius = 7000;
		loadingTexts[] = {"If you like the island please consider donatating via my Twitch channel ausisland or aussmeister@gmail.com so I can continue to improve it and add more Features.","This Version no longer requires CUP addons","Did you know? Australia is as wide as the distance between London to Moscow.","Did you know? The biggest property in Australia is bigger than Belgium.","Did you know? Australias first police force was made up of the most well-behaved convicts.","Did you know? If you visited one new beach in Australia every day, it would take over 27 years to see them all.","If you like the island please consider donatating via Paypal @ aussmeister@gmail.com so I can continue to improve it and add more Features.","Did you know? There have been no deaths in Australia from a spider bite since 1979.","Did you know? An Australian man once tried to sell New Zealand on eBay.","Did you know? The Australian Alps receive more snowfall than Switzerland.","Did you know? The average Aussie drinks 96 litres of beer per year.","Green Airport Icons on Map indicate Autolanding facilities are available.","Did you know? The name Australia comes from the Latin Terra Australis Incognito which means the Unknown Southern Land.","Did you know? All Australian Politicians are useless.","Did you know? Australians are the worlds biggest buyers of 4WD vehicles.","Did you know? In 1880 Melbourne was the richest city in the world","Did you know? In 1979 debris from NASAs space station Skylab crashed in Esperance WA.The town then fined NASA $400 for littering","There are 5 Christmas trees hidden on the island, can you find them?"};
	};
	initWorld = "australia";
	demoWorld = "australia";
};
