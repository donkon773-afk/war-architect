private _assert={params ["_ok","_name"];if (!_ok) then {throw ("MOBILITY_ASSERT_FAILED: "+_name);};NeroMotion_assertions=NeroMotion_assertions+1;};
NeroMotion_assertions=0;
private _best=100;private _last=0;private _result=[];
{_result=[100+_x/100,_best,_last,_x,true,true,false,0,8] call NeroAI_fnc_motionProgress;_best=_result # 1;_last=_result # 2;} forEach [0,2,4,6,8];
[(_result # 0)=="STALLED","rocking does not reset the progress clock"] call _assert;
_result=[96,100,0,6,true,true,false,2,8] call NeroAI_fnc_motionProgress;
[(_result # 0)=="MOVING" && {(_result # 2)==6},"real advancement refreshes progress"] call _assert;
_result=[96,96,6,20,true,true,true,0,8] call NeroAI_fnc_motionProgress;
[(_result # 0)=="QUEUE","a traffic wait is not a geometric stall"] call _assert;
_result=[96,96,6,20,false,true,false,0,8] call NeroAI_fnc_motionProgress;
[(_result # 0)=="HOLD","a deliberate hold is not recovered"] call _assert;
_result=[96,96,6,20,true,false,false,0,8] call NeroAI_fnc_motionProgress;
[(_result # 0)=="DAMAGED","immobility is damage rather than a rock"] call _assert;
_result=[100,96,6,20,true,true,false,8,8] call NeroAI_fnc_motionProgress;
[(_result # 0)=="MOVING","a vehicle driving around a bend is not reversed"] call _assert;
_result=[80,96,6,21,true,true,false,0,8] call NeroAI_fnc_motionProgress;
[(_result # 0)=="MOVING" && {(_result # 2)==21},"progress after recovery starts a new clock"] call _assert;
[[4,4,true,true,true,true,false,true] call NeroAI_fnc_motionAuthority,"current local driver owns its route"] call _assert;
[!([5,4,true,true,true,true,false,true] call NeroAI_fnc_motionAuthority),"new order invalidates the old generation"] call _assert;
[!([4,4,false,true,true,true,false,true] call NeroAI_fnc_motionAuthority),"another group cannot control the same vehicle"] call _assert;
[!([4,4,true,false,true,true,false,true] call NeroAI_fnc_motionAuthority),"locality transfer stops the old controller"] call _assert;
[!([4,4,true,true,true,true,true,true] call NeroAI_fnc_motionAuthority),"player taking the driver seat stops AI control"] call _assert;
[!([4,4,true,true,true,true,false,false] call NeroAI_fnc_motionAuthority),"borrowed vehicle driver is not commandeered"] call _assert;
[!([4,4,true,true,true,false,false,true] call NeroAI_fnc_motionAuthority),"dead driver cannot continue a path"] call _assert;
private _paths=[[100,100,0],0,4,8] call NeroAI_fnc_motionCandidates;
[count _paths==5,"bounded set of local candidates"] call _assert;
[((((_paths # 0) # 1) # 0) # 1)<100,"rear escape begins behind the hull"] call _assert;
[({(_x # 1) findIf {_x distance2D [100,100,0] > 35} >= 0} count _paths)==0,"recovery is local, never a distant cross-country route"] call _assert;
[abs (([[5,3],[0,0],[10,0]] call NeroAI_fnc_motionPointDistance)-3)<0.001,"corridor distance inside a segment"] call _assert;
[abs (([[12,0],[0,0],[10,0]] call NeroAI_fnc_motionPointDistance)-2)<0.001,"corridor distance clamps to its endpoint"] call _assert;
[abs (([[3,4],[0,0],[0,0]] call NeroAI_fnc_motionPointDistance)-5)<0.001,"zero-length corridor is well defined"] call _assert;
private _seats=[["driver",false,false],["gunner",false,false],["commander",false,false],["cargo",false,false],["turret",true,false],["turret",false,true]];
[([_seats] call NeroAI_fnc_crewSeatRoles) isEqualTo [0,1,2],"only vacant real crew seats are staffed"] call _assert;
[([[["driver",false,false],["cargo",false,false]]] call NeroAI_fnc_crewSeatRoles) isEqualTo [0],"truck requires one driver, no invented commander"] call _assert;
[([[["gunner",false,true],["driver",false,true]]] call NeroAI_fnc_crewSeatRoles) isEqualTo [],"existing crew cannot be duplicated"] call _assert;
diag_log format ["MOBILITY_TESTS_OK %1",NeroMotion_assertions];
